  "dependencies": {
    "concurrently": "^10.0.6",
    "cors": "^8.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
